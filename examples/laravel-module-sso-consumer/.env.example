# ─────────────────────────────────────────────────────────────────────────────
# GlassPortal SSO — Module Consumer Environment
# Copy to .env and fill in the values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# The shared HMAC signing secret — must match what GlassPortal uses for this module.
# Generate with: openssl rand -base64 64
GLASSPORTAL_SIGNED_LAUNCH_SECRET=

# Issuer value — must match GlassPortal's GLASSPORTAL_SSO_ISSUER (default: glassportal)
GLASSPORTAL_SSO_ISSUER=glassportal

# This module's key as registered in GlassPortal organization_module_links.module_key
GLASSPORTAL_MODULE_KEY=glasspanel

# Back-channel redeem endpoint on GlassPortal (include module key in URL)
GLASSPORTAL_BACKCHANNEL_REDEEM_URL=https://portal.example.com/api/sso/backchannel/redeem/glasspanel

# Cache store for replay detection (use redis in production)
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Session driver
SESSION_DRIVER=redis
