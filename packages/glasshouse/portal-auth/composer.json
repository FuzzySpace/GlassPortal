{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "glasshouse/portal-auth",
    "description": "GlassPortal module authentication SDK \u2014 signed launch and back-channel SSO verification.",
    "type": "library",
    "keywords": [
        "glasshouse",
        "glassportal",
        "sso",
        "signed-launch",
        "portal-auth"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "illuminate/cache": "Required for LaravelCacheReplayStore",
        "illuminate/contracts": "Required for Laravel middleware integration",
        "illuminate/http": "Required for Laravel middleware integration",
        "illuminate/support": "Required for PortalAuthServiceProvider"
    },
    "autoload": {
        "psr-4": {
            "GlassHouse\\PortalAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlassHouse\\PortalAuth\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
