# GlassPortal — example environment file
# Copy to `.env` and fill in real values for local development.
# NEVER commit a populated .env.

# --- Application ---
APP_NAME=GlassPortal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_VERSION=dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# PostgreSQL is preferred long-term (parity with GlassBilling).
# SQLite is fine for local dev without a DB server.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=glassportal
DB_USERNAME=glassportal
DB_PASSWORD=change-me

# Uncomment to use SQLite locally (simple, no server required):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/glassportal.sqlite

# --- Session / cache / queue ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=glassportal

# --- Redis (optional) ---
# Uncomment when Redis is available for cache/queues/sessions.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- Mail (local dev: log mailer) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@glasshouse.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Glasshouse ecosystem modules ---
# Set ENABLED=true and supply URL+TOKEN to activate each module connector.

# GlassBilling (Phase 4: read-only connector live)
GLASSBILLING_ENABLED=false
GLASSBILLING_BASE_URL=
GLASSBILLING_API_TOKEN=
GLASSBILLING_TIMEOUT=8
GLASSBILLING_VERIFY_TLS=true

# GlassPanel (Phase 4+)
GLASSPANEL_ENABLED=false
GLASSPANEL_API_URL=
GLASSPANEL_API_TOKEN=
GLASSPANEL_TIMEOUT=5

# Aria / GlassAI (Phase 4+)
ARIA_ENABLED=false
ARIA_API_URL=
ARIA_API_TOKEN=
ARIA_TIMEOUT=10

# Proxmox (Phase 4+)
PROXMOX_ENABLED=false
PROXMOX_API_URL=
PROXMOX_API_TOKEN=
PROXMOX_TIMEOUT=5

# PowerDNS (Phase 4+)
POWERDNS_ENABLED=false
POWERDNS_API_URL=
POWERDNS_API_KEY=
POWERDNS_TIMEOUT=5

# Mailcow (Phase 4+)
MAILCOW_ENABLED=false
MAILCOW_API_URL=
MAILCOW_API_KEY=
MAILCOW_TIMEOUT=5

# Pterodactyl (legacy migration target -> GlassPanel)
PTERODACTYL_ENABLED=false
PTERODACTYL_API_URL=
PTERODACTYL_API_TOKEN=
PTERODACTYL_TIMEOUT=5

# --- Support inbox / ticketing integration ---
# Examples: imap, helpscout, freshdesk, zammad, internal
SUPPORT_INBOX_PROVIDER=internal
SUPPORT_INBOX_HOST=
SUPPORT_INBOX_USERNAME=
SUPPORT_INBOX_PASSWORD=

# --- Future secret backend (HashiCorp Vault, AWS KMS, etc.) ---
SECRET_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=

# --- Vite / frontend (Phase 3+) ---
VITE_APP_NAME="${APP_NAME}"

# --- Signed Module Launch / SSO (Phase 8+) ---
# Required when any organization_module_link uses auth_mode=signed_launch.
# Generate: php artisan tinker --execute="echo base64_encode(random_bytes(64));"
GLASSPORTAL_SIGNED_LAUNCH_SECRET=
GLASSPORTAL_SSO_ISSUER=glassportal
# Token TTL in seconds (default 60, max 300)
GLASSPORTAL_SIGNED_LAUNCH_TTL=60

# --- Signed Launch Key ID / rotation (Phase 9) ---
# Optional. When set, tokens include "kid": key_id in the header so modules
# can select the correct verification key during key rotation.
# Leave blank for single-secret backward-compatible mode.
GLASSPORTAL_SIGNED_LAUNCH_KEY_ID=

# --- Portal launch rate limiting (Phase 9) ---
# Max launch attempts per user per module link per minute (default 20).
GLASSPORTAL_LAUNCH_RATE_LIMIT=20

# --- Dev SSO consume route (Phase 9) ---
# Enables POST /_dev/sso/consume/{moduleKey} outside local/testing environments.
# Always enabled in local + testing. Set true in staging for integration testing.
# NEVER set true in production.
GLASSPORTAL_ENABLE_DEV_SSO_CONSUME=false
