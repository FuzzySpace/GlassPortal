# GlassPortal — example environment file
# Copy to `.env` and fill in real values for local development.
# NEVER commit a populated .env.

# --- Application ---
APP_NAME=GlassPortal
APP_ENV=local
APP_URL=http://localhost:8080
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC

# --- Database (provisioning portal / Laravel scaffold) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=glassportal
DB_USERNAME=portal_user
DB_PASSWORD=change-me

# --- Session / security ---
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Glasshouse ecosystem connector endpoints (Phase 1: placeholders only) ---
GLASSBILLING_API_URL=
GLASSBILLING_API_TOKEN=

GLASSPANEL_API_URL=
GLASSPANEL_API_TOKEN=

ARIA_API_URL=
ARIA_API_TOKEN=

PROXMOX_API_URL=
PROXMOX_API_TOKEN=

POWERDNS_API_URL=
POWERDNS_API_KEY=

MAILCOW_API_URL=
MAILCOW_API_KEY=

# --- Support inbox / ticketing integration ---
# Examples: imap, helpscout, freshdesk, zammad, internal
SUPPORT_INBOX_PROVIDER=internal
SUPPORT_INBOX_HOST=
SUPPORT_INBOX_USERNAME=
SUPPORT_INBOX_PASSWORD=

# --- Future secret backend (HashiCorp Vault, etc.) ---
SECRET_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=
