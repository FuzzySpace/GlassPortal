# GlassPortal — example environment file
# Copy to `.env` and fill in real values for local development.
# NEVER commit a populated .env.

# --- Application ---
APP_NAME=GlassPortal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_VERSION=dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# PostgreSQL is preferred long-term (parity with GlassBilling).
# SQLite is fine for local dev without a DB server.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=glassportal
DB_USERNAME=glassportal
DB_PASSWORD=change-me

# Uncomment to use SQLite locally (simple, no server required):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/glassportal.sqlite

# --- Session / cache / queue ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=glassportal

# --- Redis (optional) ---
# Uncomment when Redis is available for cache/queues/sessions.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- Mail (local dev: log mailer) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@glasshouse.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Glasshouse ecosystem modules ---
# Set ENABLED=true and supply URL+TOKEN to activate each module connector.

# GlassBilling (Phase 4: read-only connector live)
GLASSBILLING_ENABLED=false
GLASSBILLING_BASE_URL=
GLASSBILLING_API_TOKEN=
GLASSBILLING_TIMEOUT=8
GLASSBILLING_VERIFY_TLS=true

# GlassBilling — Stripe-first billing foundation (Phase 24)
# GlassBilling is the billing/account/subscription/payment source of truth.
# GLASSBILLING_MODE: stripe (target) | external (legacy bridge) | off
GLASSBILLING_MODE=stripe
GLASSBILLING_CURRENCY=USD
# Stripe keys are SERVER-SIDE ONLY (except the publishable key). Never commit real
# values. Secret + webhook secret must never appear in views, logs, or healthcheck.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# GlassPanel (Phase 4+)
GLASSPANEL_ENABLED=false
GLASSPANEL_API_URL=
GLASSPANEL_API_TOKEN=
GLASSPANEL_TIMEOUT=5

# Aria / GlassAI (Phase 4+)
ARIA_ENABLED=false
ARIA_API_URL=
ARIA_API_TOKEN=
ARIA_TIMEOUT=10

# Proxmox (Phase 4+)
PROXMOX_ENABLED=false
PROXMOX_API_URL=
PROXMOX_API_TOKEN=
PROXMOX_TIMEOUT=5

# PowerDNS (Phase 4+)
POWERDNS_ENABLED=false
POWERDNS_API_URL=
POWERDNS_API_KEY=
POWERDNS_TIMEOUT=5

# Mailcow (Phase 4+)
MAILCOW_ENABLED=false
MAILCOW_API_URL=
MAILCOW_API_KEY=
MAILCOW_TIMEOUT=5

# Pterodactyl (legacy migration target -> GlassPanel)
PTERODACTYL_ENABLED=false
PTERODACTYL_API_URL=
PTERODACTYL_API_TOKEN=
PTERODACTYL_TIMEOUT=5

# --- SIONA connector (Phase 18) ---
# SIONA is an external AI sales module. GlassPortal owns registry, health check,
# and launch bridge only. SIONA source code lives in a separate repository.
#
# SIONA_API_TOKEN must NEVER appear in logs, responses, views, tests, or URLs.
# Set SIONA_ENABLED=true and supply credentials to enable live health probing.
#
# Supported launch auth modes: standalone, signed_launch, backchannel_launch
SIONA_ENABLED=false
SIONA_API_URL=
SIONA_API_TOKEN=
SIONA_LAUNCH_URL=
SIONA_TIMEOUT=5
SIONA_VERIFY_TLS=true
#
# Phase 20 — SIONA tenant provisioning (admin-only). GlassPortal can create a
# SIONA workspace for an organization over the authenticated server-to-server
# back-channel (uses SIONA_API_URL + SIONA_API_TOKEN) and auto-link it.
# Requires SIONA_ENABLED=true and a token. Off by default.
SIONA_PROVISIONING_ENABLED=false
SIONA_PROVISIONING_PATH=/api/tenants
SIONA_PROVISIONING_AUTH_MODE=signed_launch

# --- Support inbox / ticketing integration ---
# Examples: imap, helpscout, freshdesk, zammad, internal
SUPPORT_INBOX_PROVIDER=internal
SUPPORT_INBOX_HOST=
SUPPORT_INBOX_USERNAME=
SUPPORT_INBOX_PASSWORD=

# --- Future secret backend (HashiCorp Vault, AWS KMS, etc.) ---
SECRET_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=

# --- Vite / frontend (Phase 3+) ---
VITE_APP_NAME="${APP_NAME}"

# --- Signed Module Launch / SSO (Phase 8+) ---
# Required when any organization_module_link uses auth_mode=signed_launch.
# Generate: php artisan tinker --execute="echo base64_encode(random_bytes(64));"
GLASSPORTAL_SIGNED_LAUNCH_SECRET=
GLASSPORTAL_SSO_ISSUER=glassportal
# Token TTL in seconds (default 60, max 300)
GLASSPORTAL_SIGNED_LAUNCH_TTL=60

# --- Signed Launch Key ID / rotation (Phase 9) ---
# Optional. When set, tokens include "kid": key_id in the header so modules
# can select the correct verification key during key rotation.
# Leave blank for single-secret backward-compatible mode.
GLASSPORTAL_SIGNED_LAUNCH_KEY_ID=

# --- Portal launch rate limiting (Phase 9) ---
# Max launch attempts per user per module link per minute (default 20).
GLASSPORTAL_LAUNCH_RATE_LIMIT=20

# --- Dev SSO consume route (Phase 9) ---
# Enables POST /_dev/sso/consume/{moduleKey} outside local/testing environments.
# Always enabled in local + testing. Set true in staging for integration testing.
# NEVER set true in production.
GLASSPORTAL_ENABLE_DEV_SSO_CONSUME=false

# --- Back-channel SSO exchange (Phase 11) ---
# Enables server-to-server launch code redemption via POST /api/sso/backchannel/redeem/{moduleKey}.
# Required when any organization_module_link uses auth_mode=backchannel_launch.
GLASSPORTAL_BACKCHANNEL_SSO_ENABLED=false
# One-time launch code lifetime in seconds (default 60, max 300)
GLASSPORTAL_BACKCHANNEL_CODE_TTL=60
# How long used-code tombstones are retained to prevent replay attacks (default 600)
GLASSPORTAL_BACKCHANNEL_REPLAY_TTL=600

# mTLS verification (Phase 12) — set REQUIRE_MTLS=true in production
# The reverse proxy must set X-Client-Cert-Verified: SUCCESS after verifying the client cert
GLASSPORTAL_BACKCHANNEL_REQUIRE_MTLS=false
GLASSPORTAL_BACKCHANNEL_MTLS_HEADER=X-Client-Cert-Verified
GLASSPORTAL_BACKCHANNEL_MTLS_VERIFIED_VALUE=SUCCESS

# Per-module signing secrets (Phase 12) — optional, recommended for production isolation
# When set, a module's signed_launch tokens use its own dedicated secret instead of the global one.
# Compromise of one module's secret does not expose other modules.
# GLASSPORTAL_MODULE_SECRET_GLASSPANEL=
# GLASSPORTAL_MODULE_SECRET_ARIA=
# SIONA is wired into per_module_secrets (Phase 21A). Set a unique value to give
# SIONA signed_launch its own signing secret; leave empty to fall back to the
# global GLASSPORTAL_SIGNED_LAUNCH_SECRET. Never commit a real secret here.
# GLASSPORTAL_MODULE_SECRET_SIONA=

# --- Key registry / JWKS (Phase 15) ---
# Phase 15 introduces a key_registry with lifecycle statuses (active/previous/disabled).
# active_kid points to the key currently used for signing new tokens.
# Set the matching secrets in your environment — never hardcode them.
#
# Rotation workflow:
#   1. Generate new secret: openssl rand -base64 64
#   2. Add v2 entry to config/glasshouse_sso.php with status=active
#   3. Set GLASSPORTAL_SIGNED_LAUNCH_ACTIVE_KID=v2
#   4. Set GLASSPORTAL_SIGNED_LAUNCH_SECRET_V2 to the new secret
#   5. Change v1 status to "previous" — old tokens still verify
#   6. After all v1 tokens have expired, set v1 status to "disabled"
#
# Leave empty to use legacy single-secret mode (GLASSPORTAL_SIGNED_LAUNCH_SECRET above).
GLASSPORTAL_SIGNED_LAUNCH_ACTIVE_KID=
GLASSPORTAL_SIGNED_LAUNCH_SECRET_V1=
GLASSPORTAL_SIGNED_LAUNCH_SECRET_V2=
